# Backend
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/junyu_mvp.sqlite3
ENABLE_SCHEDULER=true
DATA_SYNC_CRON=5 0 * * *
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
EVENT_PACING_SECONDS=7.0

# Model provider
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-pro
DEEPSEEK_API_KEY=
ENABLE_LLM_DIALOGUE=false
ENABLE_LLM_REFINEMENT=false

# Frontend
API_PROXY_TARGET=http://localhost:8000
# Keep empty in Docker/cloud deployments so the browser calls same-origin /api.
# Only set this when the browser must call an external API domain directly.
NEXT_PUBLIC_API_BASE_URL=
